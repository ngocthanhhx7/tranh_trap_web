NODE_ENV=development
PORT=4000
# Local: 0. Production Nginx (API port private): 1.
TRUST_PROXY_HOPS=0
MONGODB_URI=mongodb://127.0.0.1:27017/tranh_trap_web
CLIENT_ORIGIN=http://localhost:5173

# Gemini: chỉ server giữ API key. Có thể thay model theo tài khoản.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Số câu trả lời AI thành công mỗi ngày/người dùng (hoặc IP của khách).
# Tính theo ngày Việt Nam; không hiển thị hạn mức ở header chat.
AI_DAILY_LIMIT=20
# Đặt trong dấu nháy nếu có dấu #. Đây là giọng điệu; không thay quy tắc bảo mật.
AI_CHAT_TONE="Gần gũi, ấm áp, nhí nhảnh vừa phải; xưng Sóc hoặc mình, gọi người dùng là bạn. Viết tiếng Việt tự nhiên, rõ ràng; dùng emoji tiết chế, không rập khuôn hay quá trang trọng."

# PayOS: tạo kênh thanh toán, khai báo webhook /api/v1/payments/webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# SMTP: dùng mật khẩu ứng dụng nếu nhà cung cấp yêu cầu.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Mức phí mặc định khi tỉnh/thành chưa có cấu hình trong dashboard admin.
SHIPPING_DEFAULT_FEE=25000
